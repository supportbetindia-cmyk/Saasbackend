# === Reuse your EXISTING Supabase project ===
# Copy this file to `.env` and fill in real values. `.env` is git-ignored;
# NEVER put real secrets in this .env.example (it is tracked).
#
# The SaaS tables are created in a dedicated "saas" schema, so your existing
# BetIndia tables in the "public" schema are never touched.
#
# Supabase → Settings → Database → Connection string.
# IMPORTANT: the "URI" (direct db.<ref>.supabase.co:5432) is IPv6-only and often
# unreachable → use the "Session pooler" string instead (IPv4, host *.pooler.supabase.com,
# username postgres.<project_ref>). Works for db push / migrations and runtime.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres"

# Supabase project (Settings → API)
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="[anon key]"
# Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET="[jwt secret]"
# Required only when the backend should send team invitation emails.
SUPABASE_SERVICE_ROLE_KEY="[service role key]"

# App
PORT=4000
NODE_ENV=development
CORS_ORIGINS="http://localhost:3060,https://admin.betindia.games"
DASHBOARD_URL="http://localhost:3060"
# Long random value used by the daily classification cron endpoint.
CRON_SECRET="replace-with-a-long-random-secret"
BACKEND_PUBLIC_URL="http://localhost:4000"
