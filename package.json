{
  "name": "customer-intelligence-backend",
  "version": "0.1.0",
  "description": "Customer Intelligence & Company Growth SaaS — multi-tenant NestJS backend",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "node --experimental-strip-types prisma/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:webhook": "npm run build --silent && node --test test/*.test.mjs",
    "cron:classification": "node scripts/run-classification-cron.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@prisma/client": "^5.22.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jose": "^5.9.0",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.0",
    "prisma": "^5.22.0",
    "typescript": "^5.7.0"
  }
}
