# BetIndia-specific values to MERGE into the official supabase/docker/.env
# after you clone it. These are the only lines that differ from the defaults
# for our app. Fill the secrets from `node gen-keys.mjs`.

############ secrets (from gen-keys.mjs) ############
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
ANON_KEY=CHANGE_ME
SERVICE_ROLE_KEY=CHANGE_ME

############ urls ############
# Public HTTPS URL that Caddy/Nginx puts in front of Kong (port 8000).
API_EXTERNAL_URL=https://api.betindia.games
SUPABASE_PUBLIC_URL=https://api.betindia.games
# Where users are sent after auth actions.
SITE_URL=https://admin.betindia.games
ADDITIONAL_REDIRECT_URLS=https://admin.betindia.games

############ auth (GoTrue) ############
# You're the only operator — skip email confirmation so logins just work.
# (Turn back on if you ever open signup to others.)
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_EMAIL_SIGNUP=true
DISABLE_SIGNUP=false

############ PostgREST ############
# Our /rest/v1/ legacy calls only touch the `public` schema (the `saas` schema is
# read by the NestJS backend directly via Prisma, not through PostgREST).
# Keep the Supabase defaults + nothing extra needed:
PGRST_DB_SCHEMAS=public,storage,graphql_public

# NOTE: leave STUDIO / dashboard creds at their defaults or set a strong password —
# Studio is only reachable on the box unless you expose it. Don't expose it publicly.
